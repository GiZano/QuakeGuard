# --- DATABASE CONFIGURATION ---
# Read from docker-compose.yml to configure Postgres
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=quakeguard_db

# --- NETWORK CONFIGURATION ---
# Port exposed on your localhost
API_PORT=8000
# Internal Docker Redis hostname
REDIS_HOST=redis
REDIS_PORT=6379
# MQTT broker (Local Mosquitto)
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- APPLICATION SECRETS ---
# It has to correspond with the ones hardcoded on the ESP32 firmware & Mobile App
ENROLLMENT_TOKEN=your_enrollment_token
IOT_API_KEY=your_iot_api_key
MOBILE_WS_TOKEN=your_mobile_ws_token

# --- SEISMIC CALIBRATION CONSTANTS ---
# Tune these against regional INGV catalog data. Defaults represent M4.0 at ~10km.
K_CALIBRATION=1.6
B_OFFSET=3.0
SENSOR_SCALE=100.0

# --- LOCAL OLLAMA (AI Emergency Reports, v1.2.0) ---
# Runs entirely on-premise inside the Docker network: telemetry never leaves the host.
# Requires starting the stack with: docker compose --profile ai up -d
# When false, the worker skips AI report generation entirely.
AI_REPORT_ENABLED=true
# OLLAMA_HOST here is the address the backend/AI-worker uses to reach the service.
OLLAMA_HOST=http://ollama:11434
# Port exposed on the host for manual inspection (docker-compose).
OLLAMA_PORT=11434
# Small edge model (Meta) — ideal for low-resource local deployments.
# Alternative: qwen2.5:1.5b
OLLAMA_MODEL=llama3.2:1b
# Inference timeout in seconds.
OLLAMA_TIMEOUT=30
# How long a loaded model stays resident in memory before being unloaded.
OLLAMA_KEEP_ALIVE=5m