# ==============================================================================
# QUAKEFINDER FIRMWARE CONFIGURATION (DEVELOPMENT TUNNEL)
# File: esp32_config.env
# Description: Environment variables injected into the firmware during build.
# Target Environment: Remote HTTPS endpoint (Cloudflare tunnel or real domain)
# ==============================================================================

# --- Network Connectivity (WiFi) ---
# SSID and Password for the local access point.
WIFI_SSID="Mockup_Lab_WiFi_5G"
WIFI_PASS="LabNetworkPass123!"

# --- Backend Connection (IoT Factory Provisioning) ---
# NOTE ON TAILSCALE/NGROK: ESP32's mbedTLS library has a limited memory buffer (16KB).
# Modern tunnels like Tailscale Funnel send massive Let's Encrypt certificate chains
# that overflow this buffer, causing TLS Handshake failures (mbedTLS error -80).
# Since this HTTP connection is ONLY used once for initial Factory Provisioning
# (while actual telemetry uses the MQTT broker globally), the best practice is to
# provision the device on the local network using the backend's local IP address.
# The mobile app, which has ample memory, can safely use the Tailscale URL.

# Target Host Domain or Local IP.
# NOTE: Do not include "http://" or "https://". Just the IP or domain name.
SERVER_HOST="192.168.X.X"

# Transport protocol. "http" for LAN testing against a local backend (recommended),
# "https" for WAN deployments using tunnels with small certificates (e.g. Cloudflare).
SERVER_PROTOCOL="http"

# Target Port. Use 8000 for local backend, 443 for HTTPS tunnels.
SERVER_PORT=8000

# API Endpoint Path.
SERVER_PATH="/readings/"

# --- Device Identity ---
# NOT configured here: the sensor ID is assigned automatically by the backend
# during the first-boot handshake (POST /devices/register) and persisted in the
# device's NVS. No manual per-sensor registration is required.

# --- MQTT Broker ---
# MQTT Broker Hostname (e.g., HiveMQ Cloud or local IP)
# NOTE: If port is 8883, firmware will automatically use TLS (WiFiClientSecure).
# If port is 1883 (local Mosquitto), firmware will automatically use plain TCP (WiFiClient).
MQTT_BROKER_HOST="your-cluster-id.s1.eu.hivemq.cloud"
MQTT_BROKER_PORT=8883
MQTT_USERNAME="your_mqtt_username"
MQTT_PASSWORD="your_mqtt_password"

# --- USB Serial Fallback  ---
# When the MQTT/WiFi data plane is unreachable, the node re-certifies each
# seismic event and emits it over the USB CDC port as a machine-readable
# [QG:FB] frame. A co-located host runs firmware/tools/serial_bridge.py to
# read it and forward it to the ingestion pipeline.
# NOTE: frames are only emitted while a real USB host is attached (the node
# retains events in an in-memory ring when it is just powered). Set to 0 to
# disable the fallback and keep the MQTT-only behaviour.
SERIAL_FALLBACK_ENABLED=1
SERIAL_FALLBACK_MARKER="[QG:FB]"

# ==============================================================================
# SECURITY & CRYPTOGRAPHY NOTE
# ==============================================================================
# Cryptographic keys (Private/Public ECDSA pairs) are NOT configured in this file.
# Keys are automatically generated by the firmware upon first initialization
# and stored securely in the device's NVS (Non-Volatile Storage) partition.
#
# Check the Serial Monitor output on boot to retrieve the Public Key.
ENROLLMENT_TOKEN=your_enrollment_token

# ==============================================================================
# OPTIONAL GNSS (v2.0.0)
# ==============================================================================
# Uncomment to compile the GNSS sub-system (GnssModule.h/.cpp): real coordinates
# are reported at registration and the last-known fix is persisted in NVS as a
# fallback for cold boots before the first satellite fix. Leave commented to
# keep the default hermetic build (omits coordinates by default).
#
# GNSS_ENABLED=1
# GPS_SERIAL_RX_PIN=5
# GPS_SERIAL_TX_PIN=4
# GPS_SERIAL_BAUD=9600
# JLCPCB PCB wiring: J4-3 (GNSS TX) -> GPIO 5 (ESP RX), J4-4 (GNSS RX) -> GPIO 4 (ESP TX), J4-5 (PPS) -> GPIO 2 (v2.0.0)

# ==============================================================================
# FALLBACK COORDINATES
# ==============================================================================
# These coordinates are used in two scenarios:
# 1. When GNSS_ENABLED=1 but the GNSS module has no fix yet (e.g., indoor testing).
# 2. When GNSS_ENABLED is commented out (hermetic build) and you want to assign 
#    hardcoded coordinates instead of being assigned to "Unknown Region" by the backend.
#
# GNSS_FALLBACK_LAT=45.4642
# GNSS_FALLBACK_LON=9.1900